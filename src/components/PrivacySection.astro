---
import { ShieldCheck, LockKeyhole } from "@lucide/astro";
---

<section class="section wrap privacy-section" id="privacy" aria-labelledby="privacy-title">
  <h2 id="privacy-title">Privacy at every step.</h2>
  <div class="privacy-grid">
    <article>
      <h3>Personal information stays private.</h3>
      <p>
        We redact all personally identifiable information (PII) before sharing
        data with AI labs. Your information is never made public.
      </p>
      <div class="privacy-illustration" aria-hidden="true">
        <ShieldCheck size={100} stroke-width={1.5} />
      </div>
    </article>
    <article>
      <h3>Protected in transit. Protected at rest.</h3>
      <p>
        Data is encrypted during transfer and while stored. Once PII redaction
        is complete, we delete the original, unredacted data and retain only
        the redacted version.
      </p>
      <div class="privacy-illustration" aria-hidden="true">
        <LockKeyhole size={100} stroke-width={1.5} />
      </div>
    </article>
  </div>
</section>

<style>
  h2 { margin-bottom: 52px; }
  .privacy-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px; }
  article { display: flex; flex-direction: column; }
  h3 { margin: 0 0 16px; font-size: 24px; line-height: 1.3; letter-spacing: -0.6px; }
  p { margin: 0 0 32px; color: #858585; font-size: 19px; line-height: 1.6; }
  .privacy-illustration { display: grid; place-items: center; margin-top: auto; min-height: 250px; border-radius: 24px; background: #e0f0ff; color: #009cf0; }
  article:nth-child(2) .privacy-illustration { background: #e9e4ff; color: #7054ff; }
  @media (max-width: 760px) {
    h2 { margin-bottom: 32px; }
    .privacy-grid { grid-template-columns: 1fr; gap: 40px; }
    h3 { font-size: 22px; }
    p { font-size: 18px; margin-bottom: 24px; }
    .privacy-illustration { min-height: 210px; border-radius: 20px; }
  }
</style>
