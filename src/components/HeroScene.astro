---
import BrandIcon from "./BrandIcon.astro";
import Icon from "./Icon.astro";
---

<div class="corpus-scene" role="img" aria-label="A spreadsheet on a tablet, a WhatsApp phone, and cropped desk accessories. The spreadsheet and business conversation are fictional illustrations.">
  <div class="tablet tablet-sheet">
    <span class="tablet-camera"></span>
    <div class="tablet-screen">
      <div class="app-window sheet-window">
        <div class="sheet-top">
          <BrandIcon name="excel" />
          <b>Operations review.xlsx</b>
          <span>
            <Icon name="chevron" size={12} />
          </span>
        </div>
        <div class="sheet-menu">File　 Home　 Insert　 Formulas　 Data</div>
        <div class="formula">
          <span>C8</span>
          <i>ƒx</i> =SUM(C3:C7)
        </div>
        <table>
          <thead>
            <tr>
              <th></th>
              <th>A</th>
              <th>B</th>
              <th>C</th>
              <th>D</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th>1</th>
              <td>Quarterly overview</td>
              <td></td>
              <td></td>
              <td></td>
            </tr>
            <tr>
              <th>2</th>
              <td>WORKSTREAM</td>
              <td>OWNER</td>
              <td>PROJECTS</td>
              <td>STATUS</td>
            </tr>
            <tr>
              <th>3</th>
              <td>Customer success</td>
              <td>Alex</td>
              <td>24</td>
              <td>On track</td>
            </tr>
            <tr>
              <th>4</th>
              <td>Product delivery</td>
              <td>Maya</td>
              <td>18</td>
              <td>On track</td>
            </tr>
            <tr>
              <th>5</th>
              <td>Operations</td>
              <td>Jamie</td>
              <td>32</td>
              <td>On track</td>
            </tr>
            <tr>
              <th>6</th>
              <td>Team enablement</td>
              <td>Sam</td>
              <td>12</td>
              <td>Complete</td>
            </tr>
            <tr>
              <th>7</th>
              <td>Research</td>
              <td>Alex</td>
              <td>8</td>
              <td>Complete</td>
            </tr>
            <tr>
              <th>8</th>
              <td>Total projects</td>
              <td></td>
              <td class="selected-cell">94</td>
              <td></td>
            </tr>
          </tbody>
        </table>
        <div class="sheet-bottom">
          ＋　 <b>Q3 overview</b>　 Workflow history
        </div>
      </div>
    </div>
    <span class="tablet-home"></span>
  </div>
  <div class="phone">
    <div class="phone-screen business-chat-screen">
      <img src="/desk/business-chat.png" width="876" height="1796" alt="" />
    </div>
  </div>
  <img class="desk-object desk-coffee" src="/desk/metal-mug.png" width="1280" height="1280" alt="" />
  <img class="desk-object desk-notebook" src="/desk/notebook.png" width="1024" height="1536" alt="" />
  <img class="desk-object desk-pencils" src="/desk/pencil.png" width="1024" height="1536" alt="" />
</div>
